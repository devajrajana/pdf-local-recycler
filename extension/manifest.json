{
  "manifest_version": 3,
  "key": "",
  "name": "Local PDF Recycler",
  "version": "1.3",
  "description": "Moves current local PDF to Windows Recycle Bin and closes the tab.",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "notifications"
  ],
  "host_permissions": [
    "https://devajrajana.github.io/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Delete Local PDF",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "delete-pdf": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Delete active local PDF file"
    }
  }
}